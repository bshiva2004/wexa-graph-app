# CognoDB Cloud Connection Settings
# From your CognoDB console (https://console.cognodb.com):
# URI Format: bolt+s://<instance-id>.databases.cognodb.cloud
COGNODB_URI=bolt+s://your-instance-id.databases.cognodb.cloud
COGNODB_USER=cognodb
COGNODB_PASSWORD=your_generated_password

# Server Port
PORT=5000

